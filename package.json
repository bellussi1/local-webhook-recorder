{
  "name": "local-webhook-recorder",
  "version": "0.1.0",
  "type": "module",
  "description": "Record webhook requests locally and replay selected events to test handlers.",
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "author": "Enzo Bellussi",
  "repository": {"type":"git","url":"git+https://github.com/bellussi1/local-webhook-recorder.git"},
  "bugs": {"url":"https://github.com/bellussi1/local-webhook-recorder/issues"},
  "keywords": ["webhook","cli","sqlite","replay","developer-tools"],
  "files": ["dist","README.md","LICENSE"],
  "bin": {
    "webhook-recorder": "dist/cli.js"
  },
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
